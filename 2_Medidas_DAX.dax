// =====================================================================
// Painel de Crédito e Inadimplência no Brasil - Tabelas e medidas DAX
// =====================================================================

// ---------- TABELA CALENDÁRIO (Modelagem > Nova tabela) ----------
dCalendario =
ADDCOLUMNS (
    CALENDAR ( DATE ( 2015, 1, 1 ), MAX ( fSeries[Data] ) ),
    "Ano", YEAR ( [Date] ),
    "Mês Nº", MONTH ( [Date] ),
    "Mês", FORMAT ( [Date], "MMM" ),
    "Ano-Mês", FORMAT ( [Date], "YYYY-MM" )
)
// Relacione dCalendario[Date] (1) -> fSeries[Data] (*)
// Marque dCalendario como tabela de datas

// ---------- MEDIDAS BASE (crie numa tabela "_Medidas") ----------
Valor Médio =
AVERAGE ( fSeries[Valor] )

Data Mais Recente =
MAX ( fSeries[Data] )

Valor Último =
VAR UltimaData = MAX ( fSeries[Data] )
RETURN
    CALCULATE ( AVERAGE ( fSeries[Valor] ), fSeries[Data] = UltimaData )

Valor 12 Meses Atrás =
VAR UltimaData = MAX ( fSeries[Data] )
RETURN
    CALCULATE (
        AVERAGE ( fSeries[Valor] ),
        REMOVEFILTERS ( dCalendario ),
        fSeries[Data] = EDATE ( UltimaData, -12 )
    )

Variação 12m (p.p.) =
[Valor Último] - [Valor 12 Meses Atrás]

Média 12 Meses =
VAR UltimaData = MAX ( fSeries[Data] )
RETURN
    CALCULATE (
        AVERAGE ( fSeries[Valor] ),
        REMOVEFILTERS ( dCalendario ),
        fSeries[Data] > EDATE ( UltimaData, -12 ),
        fSeries[Data] <= UltimaData
    )

Máxima Histórica =
CALCULATE ( MAX ( fSeries[Valor] ), REMOVEFILTERS ( dCalendario ) )

// ---------- MEDIDAS DOS CARTÕES (KPIs) ----------
KPI Inadimplência PF =
CALCULATE ( [Valor Último], fSeries[Codigo] = 21084 )

KPI Inadimplência PF Var 12m =
CALCULATE ( [Variação 12m (p.p.)], fSeries[Codigo] = 21084 )

KPI Juros PF (a.a.) =
CALCULATE ( [Valor Último], fSeries[Codigo] = 20716 )

KPI Selic (a.a.) =
CALCULATE ( [Valor Último], fSeries[Codigo] = 4189 )

KPI Endividamento Famílias =
CALCULATE ( [Valor Último], fSeries[Codigo] = 29037 )

// A série 20541 vem em milhões de reais (portal de dados abertos do BCB).
// Dividir por 1.000.000 mostra o valor em R$ trilhões.
KPI Saldo Crédito PF (R$ tri) =
CALCULATE ( [Valor Último], fSeries[Codigo] = 20541 ) / 1000000

// Spread aproximado: juros médios PF menos Selic (em pontos percentuais)
Spread PF x Selic (p.p.) =
[KPI Juros PF (a.a.)] - [KPI Selic (a.a.)]

// ---------- TEXTO DINÂMICO (para títulos e caixas de insight) ----------
Texto Atualização =
"Dados até " & FORMAT ( CALCULATE ( MAX ( fSeries[Data] ), fSeries[Codigo] = 21084 ), "MMMM/YYYY" )
    & " | Fonte: Banco Central do Brasil (SGS)"

Texto Inadimplência =
VAR v = [KPI Inadimplência PF]
VAR d = [KPI Inadimplência PF Var 12m]
RETURN
    "A inadimplência das pessoas físicas está em " & FORMAT ( v, "0.0" ) & "%, "
        & IF ( d >= 0, "alta", "queda" ) & " de " & FORMAT ( ABS ( d ), "0.0" )
        & " p.p. em 12 meses."

// ---------- FORMATAÇÃO CONDICIONAL ----------
// Para inadimplência, subir é ruim: vermelho se > 0, verde se < 0
Cor Variação =
IF ( [Variação 12m (p.p.)] > 0, "#C0392B", "#1E8449" )

// ---------- SÉRIES PARA GRÁFICOS COM DOIS EIXOS (página 3) ----------
Selic =
CALCULATE ( [Valor Médio], fSeries[Codigo] = 4189 )

Inadimplência PF =
CALCULATE ( [Valor Médio], fSeries[Codigo] = 21084 )

Juros Cartão (a.m.) =
CALCULATE ( [Valor Médio], fSeries[Codigo] = 25479 )

Inadimplência Cartão =
CALCULATE ( [Valor Médio], fSeries[Codigo] = 21129 )
